# Your GraphAcademy Neo4j sandbox.
# Copy these from the credentials panel in the "Installation and Configuration"
# lesson of the course.
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
# The database to use. Leave as neo4j unless your credentials panel shows another name.
NEO4J_DATABASE=neo4j

# Your GraphAcademy language model access.
# Accept the terms in the "Workshop AI access" panel in the same lesson and copy
# the API key and base URL here.
#
# OPENAI_BASE_URL is what sends the OpenAI SDK to GraphAcademy rather than to
# OpenAI. Without it the key is rejected. The name matters: the OpenAI SDK reads
# OPENAI_BASE_URL from the environment, so no script has to configure it.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://graphacademy.neo4j.com/api/llm/v1
